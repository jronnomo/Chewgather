{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": null,
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "customConditions": [
      "react-native-strict-api"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "backend",
    "expo-env.d.ts"
  ]
}
