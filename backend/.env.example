PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/chewabl?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend) — used for forgot-password OTP emails
# Leave RESEND_API_KEY unset to use the console-log fallback (dev/test)
RESEND_API_KEY=
# Sender address shown in outbound emails; defaults to 'Chewgather <noreply@send.chewgather.com>'
# Must be on a domain verified in Resend (send.chewgather.com), NOT the root domain
EMAIL_FROM=Chewgather <noreply@send.chewgather.com>
